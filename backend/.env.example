PORT=3000
HOST=0.0.0.0

# Leave MONGODB_URL unset to keep using the local JSON fallback store.
# Set it to use MongoDB Community instead.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=focusmatrix

# Optional hosted cache layer.
# Leave VALKEY_URL unset to disable cache and use direct reads only.
VALKEY_URL=
